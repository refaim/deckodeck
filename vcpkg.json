{
  "name": "pvdkit",
  "version-string": "monorepo",
  "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
  "dependencies": [
    "doctest"
  ],
  "default-features": [
    "avif",
    "rpgmvp"
  ],
  "features": {
    "avif": {
      "description": "AVIF.pvd: libavif with the dav1d decoder (pulls libyuv)",
      "dependencies": [
        {
          "name": "libavif",
          "features": [
            "dav1d"
          ]
        }
      ]
    },
    "rpgmvp": {
      "description": "RPGMVP.pvd: RPG Maker MV/MZ encrypted PNG via libspng",
      "dependencies": [
        "libspng"
      ]
    }
  }
}
