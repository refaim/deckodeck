// VERSIONINFO resource of AVIF.pvd. Every value comes from the generated pvd/Version.hpp
// (CMake project version, AVIFPVD_AUTHOR / AVIFPVD_COPYRIGHT, library versions); nothing here
// is typed twice. Compiled by llvm-rc, which preprocesses with clang.
#pragma code_page(65001)

#include <windows.h>

#include "pvd/Version.hpp"

VS_VERSION_INFO VERSIONINFO
FILEVERSION AVIFPVD_VERSION_MAJOR, AVIFPVD_VERSION_MINOR, AVIFPVD_VERSION_PATCH, 0
PRODUCTVERSION AVIFPVD_VERSION_MAJOR, AVIFPVD_VERSION_MINOR, AVIFPVD_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // US English, Unicode: the block the e2e version test and Explorer read.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", AVIFPVD_AUTHOR
            VALUE "FileDescription", "AVIF decoder plugin for PictureView (Far Manager)"
            VALUE "FileVersion", AVIFPVD_VERSION_STRING
            VALUE "InternalName", "AVIF.pvd"
            VALUE "LegalCopyright", AVIFPVD_COPYRIGHT
            VALUE "OriginalFilename", "AVIF.pvd"
            VALUE "ProductName", "AVIF.pvd"
            VALUE "ProductVersion", AVIFPVD_VERSION_STRING
            VALUE "Comments", AVIFPVD_PLUGIN_COMMENTS
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
