#pragma once

// Generated by pvdkit_plugin_identity() in cmake/pvdkit-plugin.cmake for one plugin, from the
// name, version, priority, description and comments its CMakeLists.txt declares and the
// PVDKIT_AUTHOR / PVDKIT_COPYRIGHT cache variables. This is the single source of the plugin's
// identity: `Exports.cpp` and the plugin's composition root read `kPluginIdentity`, the shared
// `Plugin.rc` reads the macros into the VERSIONINFO resource, and the e2e version-resource test
// compares the two. Edit the template (src/pvd/PluginConstants.hpp.in), never the generated copy.

#define PVDKIT_PLUGIN_NAME "@PVDKIT_PLUGIN_NAME@"
#define PVDKIT_PLUGIN_FILENAME "@PVDKIT_PLUGIN_NAME@.pvd"
#define PVDKIT_PLUGIN_PRIORITY @PVDKIT_PLUGIN_PRIORITY@
#define PVDKIT_PLUGIN_VERSION_MAJOR @PVDKIT_PLUGIN_VERSION_MAJOR@
#define PVDKIT_PLUGIN_VERSION_MINOR @PVDKIT_PLUGIN_VERSION_MINOR@
#define PVDKIT_PLUGIN_VERSION_PATCH @PVDKIT_PLUGIN_VERSION_PATCH@
#define PVDKIT_PLUGIN_VERSION "@PVDKIT_PLUGIN_VERSION@"
#define PVDKIT_PLUGIN_AUTHOR "@PVDKIT_PLUGIN_AUTHOR_ESCAPED@"
#define PVDKIT_PLUGIN_COPYRIGHT "@PVDKIT_PLUGIN_COPYRIGHT_ESCAPED@"
#define PVDKIT_PLUGIN_DESCRIPTION "@PVDKIT_PLUGIN_DESCRIPTION_ESCAPED@"
#define PVDKIT_PLUGIN_COMMENTS "@PVDKIT_PLUGIN_COMMENTS_ESCAPED@"

// llvm-rc preprocesses Plugin.rc with RC_INVOKED defined and understands only the macros above.
#ifndef RC_INVOKED

#include <cstdint>
#include <string_view>

#include "pvd/PluginIdentity.hpp"

namespace pvdkit::pvd {

inline constexpr PluginIdentity kPluginIdentity{
    std::uint32_t{PVDKIT_PLUGIN_PRIORITY}, std::string_view{PVDKIT_PLUGIN_NAME},
    std::string_view{PVDKIT_PLUGIN_VERSION}};

// The host receives `data()` of these views as C strings, so they must stay literal-backed and
// therefore null-terminated; the asserts read the literal's terminator to pin that.
static_assert(kPluginIdentity.name.data()[kPluginIdentity.name.size()] == '\0');
static_assert(kPluginIdentity.version.data()[kPluginIdentity.version.size()] == '\0');
static_assert(!kPluginIdentity.name.empty(), "a plugin needs a name");
static_assert(!kPluginIdentity.version.empty(), "a plugin needs a version");

}  // namespace pvdkit::pvd

#endif  // RC_INVOKED
